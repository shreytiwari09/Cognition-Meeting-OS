{
  "manifest_version": 3,
  "name": "Cognition MeetingOS",
  "version": "2.1",
  "description": "Captures Google Meet captions with speaker names and turns meetings into tasks automatically",
  "permissions": ["storage", "tabs", "notifications", "tabCapture", "offscreen"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://cognition-meetingos.onrender.com/*",
    "http://localhost:8010/*",
    "http://localhost:8000/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["captions.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:5174/*", "http://localhost:5173/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cognition MeetingOS",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
