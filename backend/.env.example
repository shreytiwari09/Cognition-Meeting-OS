# LLM used by the CrewAI agents and meeting chat (any LiteLLM model id)
LLM_MODEL=gemini/gemini-3.6-flash
GEMINI_API_KEY=your_gemini_api_key

# Speech-to-text for call audio recorded by the extension (Whisper on Groq; free tier is enough).
# Leave empty to use Meet's captions only. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
TRANSCRIBE_MODEL=whisper-large-v3-turbo

# Firebase Admin credentials: paste the service-account JSON on one line,
# or leave unset and place backend/firebase-service-account.json locally (gitignored)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Comma-separated list of origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5174

APP_NAME=Cognition MeetingOS
